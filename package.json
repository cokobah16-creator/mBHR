{
  "name": "mBHR",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 src --ext .ts,.tsx",
    "lint:fix": "eslint --fix src --ext .ts,.tsx",
    "test:accept": "node scripts/acceptance.js || true",
    "seed": "node scripts/seed.js",
    "quality": "npm run typecheck && npm run lint",
    "analyze": "vite build && echo 'Bundle analysis saved to .bolt-artifacts/stats.html'",
    "i18n:check": "tsx scripts/i18n-verify.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.10.0",
    "@sentry/react": "^10.21.0",
    "@supabase/supabase-js": "^2.58.0",
    "dexie": "^3.2.7",
    "dexie-react-hooks": "^1.1.7",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.0.0",
    "idb-keyval": "^6.2.1",
    "metaphone": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.63.0",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^6.28.0",
    "ulid": "^2.4.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.6",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "terser": "^5.44.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.20",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^4.0.2"
  }
}
