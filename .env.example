# ─────────────────────────────────────────────────────────────────────────────
# MedBridge HealthReach (mBHR) – Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to git.
#
# Vercel Supabase Integration (https://vercel.com/integrations/supabase)
# automatically injects SUPABASE_URL, SUPABASE_ANON_KEY, and
# SUPABASE_SERVICE_ROLE_KEY into your Vercel project.
# Add the VITE_ prefixed equivalents below to expose them to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Required for online sync and authentication.
# Leave empty to run in offline-only mode.
#
# Find these in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The public URL of your deployed app.
# Used by Supabase Auth to build email confirmation redirect links.
# In production this should match your Vercel deployment URL.
VITE_APP_URL=http://localhost:5173

# ── Sentry error tracking ────────────────────────────────────────────────────
# Optional. Leave empty to disable.
# Get your DSN from https://sentry.io/
VITE_SENTRY_DSN=

# ── Site metadata ────────────────────────────────────────────────────────────
VITE_SITE_NAME="Med Bridge Health Reach"
VITE_ORGANIZATION="Dr. Isioma Okobah Foundation"

# ── Televisits ───────────────────────────────────────────────────────────────
# Base URL of the Jitsi Meet server used to build video visit links.
# Optional. Defaults to the public https://meet.jit.si when left empty.
# Point this at a self-hosted Jitsi instance to keep calls on your own
# infrastructure. No trailing slash.
VITE_TELEVISIT_BASE_URL=https://meet.jit.si

# ── Patient portal code sign-in ──────────────────────────────────────────────
# Which one-time-code sign-in options the patient portal offers: "sms",
# "email" or "sms,email". Empty (the default) hides code sign-in. Supabase Auth
# sends and checks the codes; switch a channel on here only after it is
# switched on in Supabase Auth (phone sign-in needs its SMS hook deployed).
VITE_PORTAL_CODE_CHANNELS=

# ── SMS (server-side only) ───────────────────────────────────────────────────
# There are NO browser variables for SMS. Never add VITE_TERMII_API_KEY or any
# other provider key here: every VITE_ variable is bundled into the app and
# readable by anyone who opens it. Provider keys are Supabase function secrets:
#
#   supabase secrets set TERMII_API_KEY=... TERMII_SENDER_ID=...
#   supabase secrets set RATE_LIMIT_KEY_SALT=<random string>
#
# SMS is sent only by the send-sms-reminder / send-otp-sms functions, for
# signed-in staff whose role may send SMS. See docs/deployment/SMS_SETUP_TERMII.md.
